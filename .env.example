# Copy to .env; never commit .env. Use unquoted values (also read as Java properties).
# Required: set distinct, randomly generated values. No usable credentials are shipped.
DB_PASSWORD=
JWT_SECRET=
MYSQL_ROOT_PASSWORD=
DB_USERNAME=mail_app
DB_URL=jdbc:mysql://localhost:3306/mail_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SERVER_PORT=8080
WEB_PORT=5173
TZ=Asia/Shanghai
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_PATH=/chat/completions
LLM_MODEL=glm-4-flash
# Optional: alternative Maven repository URL for container builds if Central is blocked.
MAVEN_MIRROR=https://repo.maven.apache.org/maven2
